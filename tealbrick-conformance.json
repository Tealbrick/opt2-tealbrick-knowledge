{
  "setup": [
    {
      "id": "agent_a_areas",
      "as": "agentA",
      "op": "areas_list",
      "input": {},
      "capture": {
        "area0": "/areas/0/id"
      }
    },
    {
      "id": "agent_a_tagged_memory",
      "as": "agentA",
      "op": "remember",
      "input": {
        "text": "narrowingprobe a tagged memory for the narrowing check",
        "tags": [
          "work"
        ]
      }
    },
    {
      "id": "app_area_grant",
      "as": "owner",
      "op": "tb.scopes_set",
      "input": {
        "agent": "${tb.app}",
        "type": "area",
        "id": "${area0}",
        "access": "read_write"
      }
    }
  ],
  "inputs": {
    "remember": {
      "text": "conformance memory (remember needs text or items since 0.1.25)"
    }
  },
  "inputsAs": {
    "app": {
      "remember": {
        "text": "conformance app memory",
        "area": "${area0}"
      }
    }
  },
  "dynamic": {
    "engine": {
      "resolveTools": [
        "conformance_stub_read",
        "conformance_stub_delete"
      ]
    }
  },
  "narrowing": {
    "op": "documents_search",
    "input": {
      "query": "narrowingprobe"
    },
    "tag": "work"
  }
}
